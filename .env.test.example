# Test environment defaults for local and agent runs.
APP_ENV=test
SECRET_KEY=test-secret
TEST_DATABASE_URL=sqlite:///./.tmp/hithero-test.sqlite
PYTHONPATH=tests/stubs
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1

# Frontend/browser test defaults.
PUBLIC_BACKEND_ORIGIN=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:4173
TEST_RECAPTCHA_TOKEN=hithero-test-recaptcha

# Optional parallelism controls.
PYTEST_WORKERS=auto
PYTEST_E2E_WORKERS=2
INTEGRATION_WORKERS=2
PLAYWRIGHT_WORKERS=50%
