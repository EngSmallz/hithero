# Backend local development
APP_ENV=development
SECRET_KEY=dev-secret
DATABASE_URL=sqlite:///./.local/hithero-dev.sqlite

# Frontend-to-backend integration
PUBLIC_BACKEND_ORIGIN=http://localhost:8000
PUBLIC_RECAPTCHA_MODE=mock
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production SQL Server settings are still used when APP_ENV is not test/local
# and DATABASE_URL is not set.
DATABASE_SERVER=
DATABASE_NAME=
DATABASE_UID=
DATABASE_PASSWORD=
DATABASE_PORT=

# Optional persistent test database. The default test path in Makefile is
# sqlite:///./.tmp/hithero-test.sqlite.
TEST_DATABASE_URL=sqlite:///./.tmp/hithero-test.sqlite
